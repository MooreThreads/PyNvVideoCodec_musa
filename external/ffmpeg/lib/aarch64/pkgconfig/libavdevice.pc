prefix=/ffmpeg-build
exec_prefix=${prefix}
libdir=/ffmpeg-build/lib
includedir=/ffmpeg-build/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 61.3.100
Requires: 
Requires.private: libavfilter >= 10.4.100, libswscale >= 8.3.100, libavformat >= 61.7.100, libavcodec >= 61.19.100, libswresample >= 5.3.100, libavutil >= 59.39.100
Conflicts:
Libs: -L${libdir}  -lavdevice 
Libs.private: -lm -latomic -ldrm -lxcb -lxcb-shm -lxcb-shape -lxcb-xfixes
Cflags: -I${includedir}
