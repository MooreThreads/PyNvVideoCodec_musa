prefix=/ffmpeg-build
exec_prefix=${prefix}
libdir=/ffmpeg-build/lib
includedir=/ffmpeg-build/include

Name: libavformat
Description: FFmpeg container format library
Version: 61.7.100
Requires: 
Requires.private: libavcodec >= 61.19.100, libavutil >= 59.39.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -latomic -lbz2 -lz
Cflags: -I${includedir}
